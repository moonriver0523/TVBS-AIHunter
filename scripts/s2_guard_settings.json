{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/GitHub/TVBS-AIHunter/scripts/s2_bash_guard.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/GitHub/TVBS-AIHunter/scripts/s2_gate_guard.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__browser__browser_evaluate",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/GitHub/TVBS-AIHunter/scripts/s2_browser_guard.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/GitHub/TVBS-AIHunter/scripts/s2_gate_guard.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python E:/GitHub/TVBS-AIHunter/scripts/s2_gate_guard.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
