# 工作暫存目錄（whisper 模型、yt-dlp、ffmpeg 等大型二進位）
.tmp-*/
downloads/

# 素材本體與工作產物：一律不進 repo，正式交付在 Google Drive「Claude共用」
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.bin
*.exe

# 根目錄的逐案工作檔（外電文稿／ASR／完成文稿／截圖等）
# 規則庫本身的 .md 不受影響；學習案例在 common/auto-script-learning/ 底下，不套用本段
/*.txt
/*.json
/*.jpg
/*.png

# Python
__pycache__/
*.pyc

# 工作狀態（進度快照等操作性檔案，不進版控）
.omc/
.superpowers/

# 語料清除用的機密字串清單：內含真實帳密，絕對不可進版控
style-corpus/.secret-tokens.txt
scripts/_task2_test_out/

# 試作產出的成品網頁：內含晚班交接正文（路透／AP 限制條款素材），不進版控。
# 只留腳本與模板；成品一律寫 D:\Downloads（見 scripts/prototype/*.py 檔頭）。
scripts/prototype/*-tc-matrix-*.html
scripts/prototype/0*.html

scripts/_guard_calls.log*

# PyInstaller 打包產物（scripts/build_*.md 或指令重跑即可重建，不進 repo）
scripts/build/
scripts/dist/
scripts/*.spec

# V5 切換器每次 -On 產生的 V4 備份（-Off 用完即可丟，不進版控）
scripts/_s2_scan_prompt_v4.bak.md

# 掃帶輪的 scratch 誤落 repo 根目錄（cwd 不是本輪資料夾時，相對路徑就寫到這裡）。
# 正本一律在 G:\...\自動掃帶系統\{YYYYMMDD}\，repo 這份是廢的，別進版控。
/20[0-9][0-9][0-1][0-9][0-3][0-9]/

# 一次性的 scratch／暫存腳本，跑完就丟，不進版控。
.scratch/
scripts/_tmp/
